# ============================================================
# .env — Copy this to .env and fill in your values
# NEVER commit the real .env to git
# ============================================================

# Gemini (get free key at: aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Shopify — get from: Store admin → Settings → Apps → Develop apps
# → Create app → Configuration → enable write_products, read_products
# → API credentials → "Admin API access token" (starts with shpat_)
SHOPIFY_SHOP_NAME=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...

# Optional: residential proxy for scraping protected stores
# PROXY_URL=http://username:password@proxy-host:port
